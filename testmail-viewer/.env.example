# Required. Signs session cookies and encrypts saved API keys.
# Generate one: npm run secret
AUTH_SECRET=

# Open signups need somewhere to keep accounts. Add a Redis store from the
# Vercel Marketplace and these arrive on their own; Upstash's own names
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN) work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Accounts that work without a store, comma separated: username:password
# Hash each password with: npm run hash -- their-password
# AUTH_USERS=aarav:scrypt$4f1c…$9ab3…

# Optional. Ask for this code before letting anyone create an account.
# SIGNUP_CODE=

# Optional. Set to "closed" to turn signups off while keeping the store.
# SIGNUPS=

# No testmail credentials here — every account adds their own key and
# namespace in the app, from https://testmail.app/console
